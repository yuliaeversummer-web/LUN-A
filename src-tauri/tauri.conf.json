{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "LUNÉA", "version": "0.1.0", "identifier": "app.lunea.audio",
 "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
 "app": {
  "windows": [
   { "label": "main", "title": "LUNÉA — Audio Control", "visible": false, "width": 1100, "height": 720, "minWidth": 850, "minHeight": 560, "decorations": false, "resizable": true, "shadow": false },
   { "label": "overlay", "title": "LUNÉA — Компактная панель", "url": "index.html#/overlay", "visible": false, "width": 360, "height": 332, "resizable": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "transparent": true, "shadow": false, "backgroundColor": [0, 0, 0, 0] }
  ],
  "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost", "capabilities": ["main-window", "desktop-shared", "overlay-window"] }
 },
 "bundle": {
  "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"],
  "windows": {
   "allowDowngrades": false,
   "nsis": {
    "template": "installer/template.nsi",
    "installerHooks": "installer/lunea.nsh",
    "installMode": "currentUser",
    "languages": ["Russian"],
    "displayLanguageSelector": false,
    "installerIcon": "icons/icon.ico",
    "uninstallerIcon": "icons/icon.ico",
    "headerImage": "installer/assets/header.bmp",
    "uninstallerHeaderImage": "installer/assets/header.bmp"
   }
  }
 }
}

